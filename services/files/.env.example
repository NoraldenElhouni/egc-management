# Copy to .env (never commit it).

# The Supabase project this instance serves:
#   local dev  -> the dev copy (efldlwxgttlqkydvkfzt)
#   EGC server -> production (bhcprgzqhvnymthgtvtw)
SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key only. The service never holds a service-role key.
SUPABASE_ANON_KEY=

# Must equal the Vault secret `files_service_secret` in the same project:
#   select vault.create_secret('<value>', 'files_service_secret');
FILES_SERVICE_SECRET=

# Where files are stored. Docker overrides this to the mounted volume.
STORAGE_ROOT=./.storage
MAX_FILE_MB=100
PORT=8002

# Comma-separated origins allowed by CORS, or * (auth is a bearer token).
ALLOWED_ORIGINS=*
