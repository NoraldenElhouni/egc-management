{
  "name": "egc-files-service",
  "version": "1.0.0",
  "private": true,
  "description": "Stores EGC project drawing files on the EGC server; every permission check is delegated to Supabase.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
